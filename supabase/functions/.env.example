# Local secrets for `supabase functions serve`. Copy to supabase/functions/.env (gitignored).
# In the hosted project, set these with `supabase secrets set NAME=value` instead.

# Required for AI tasks. Without it they return 503 not_configured (delete_me still works).
ANTHROPIC_API_KEY=

# Optional. Default claude-opus-5-5; claude-haiku-5-5 is much cheaper.
# CLAUDE_MODEL=claude-opus-5-5

# Optional daily limits (UTC days). 0 turns cloud AI off.
# AI_DAILY_LIMIT_PER_USER=60
# AI_DAILY_LIMIT_GLOBAL=3000
